{
  "name": "ihep-application",
  "version": "1.0.0",
  "private": true,
  "description": "Integrated Health Empowerment Program - Multi-Condition Healthcare Platform",
  "workspaces": [
    "frontend",
    "backend/*/package.json"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python -m flask run",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && pip install -r requirements.txt",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && pytest",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && flake8 && black --check .",
    "deploy:staging": "npm run deploy:infrastructure:staging && npm run deploy:services:staging",
    "deploy:production": "npm run deploy:infrastructure:production && npm run deploy:services:production"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ihep-platform/ihep-application"
  },
  "license": "PROPRIETARY",
  "author": "IHEP Foundation",
  "overrides": {
    "lodash": "4.18.1",
    "flatted": "3.4.4",
    "follow-redirects": "1.16.1",
    "form-data": "4.0.6",
    "browserslist": "4.29.3",
    "baseline-browser-mapping": "2.11.27",
    "shell-quote": "1.12.0",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "js-yaml@^3": "3.15.2",
    "js-yaml@^4": "4.3.2",
    "minimatch@^3": "3.1.5",
    "minimatch@^9": "9.0.9",
    "nanoid@^3": "3.3.19",
    "picomatch@^2": "2.3.2",
    "picomatch@^4": "4.0.7",
    "fflate@^0.6": "0.6.11",
    "fflate@^0.8": "0.8.3",
    "sharp": "0.35.5",
    "axios": "1.20.0",
    "postcss": "8.5.28"
  }
}
